class Book:
    def __init__(self, title, author, copies):
        self.title = title
        self.author = author
        self._copies = copies

    @property
    def copies(self):
        return self._copies

    @copies.setter
    def copies(self, value):
        if value >= 0:
            self._copies = value
        else:
            raise ValueError(
                "Ошибка! Количество копий не могут быть отрицательными!")

    def __str__(self):
        return f"Книга: '{self.title}' (автор: {self.author}. В наличии: {self.copies} шт.)"

    def take_book(self):
        if self.copies > 0:
            self.copies -= 1
            return True
        else:
            raise ValueError("Книги нет в наличии")

    def return_book(self):
        self.copies += 1


class Reader:
    def __init__(self, name):
        self.name = name
        self.taken_books = []

    def borrow_book(self, book, limit=3):
        self.limit = limit
        if len(self.taken_books) >= limit:
            print(f"{self.name} не может взять больше книг")
        else:
            try:
                book.take_book()
                print(f"{self.name} взял книгу '{book.title}'")
                self.taken_books.append(book)       
            except ValueError as e:
                print(f"Не удалось взять книгу: {e}")
                return
            

    def return_book(self, book):
        book.return_book()
        self.taken_books.remove(book)
        print(f"{self.name} вернул книгу '{book.title}'")


class VIPReader(Reader):
    def __init__(self, name):
        super().__init__(name)

    def borrow_book(self, book):
            super().borrow_book(book, 5)



