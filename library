class Book:
    def __init__(self, title, author, copies):
        self.title = title
        self.author = author
        self._copies = copies

    @property
    def copies(self):
        return self._copies

    @copies.setter
    def copies(self, value):
        if value > 0:
            return self._copies
        else:
            raise ValueError(
                "Ошибка! Количество копий не могут быть отрицательными!")

    def __str__(self):
        return f"Книга: '{self.title}' (автор: {self.author}. В наличии: {self.copies} шт.)"

    def take_book(self):
        if self.copies > 0:
            self.copies -= 1
            return True
        else:
            raise ValueError("Книги нет в наличии")

    def return_book(self):
        self.copies += 1
