class Book:
    def __init__(self, title, author, copies):
        self.title = title
        self.author = author
        self._copies = copies

    @property
    def copies(self):
        return self._copies

    @copies.setter
    def copies(self, value):
        if value > 0:
            return self._copies
        else:
            raise ValueError(
                "Ошибка! Количество копий не могут быть отрицательными!")

    def __str__(self):
        return f"Книга: '{self.title}' (автор: {self.author}. В наличии: {self.copies} шт.)"

    def take_book(self):
        if self.copies > 0:
            self.copies -= 1
            return True
        else:
            raise ValueError("Книги нет в наличии")

    def return_book(self):
        self.copies += 1


class Reader:
    def __init__(self, name):
        self.name = name
        self.taken_books = [0]

    def borrow_book(self, book):
        try:
            result = book.take_book()
        except ValueError as e:
            print(f"Не удалось взять книгу: {e}")
        if result == True and self.taken_books[0] < 1:
            print(f"{self.name} взял книгу '{book.title}'")
            self.taken_books.append(book)
            self.taken_books[0] += 1
        elif self.taken_books > 1:
            print(
                f"{self.name} не может взять больше книг, так как превышен максимум: 1")

    def return_book(self, book):
        book.return_book()
        self.taken_books.remove(book)
